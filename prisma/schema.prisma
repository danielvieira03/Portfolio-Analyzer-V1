// Portfolio data model. SQLite file lives locally and is git-ignored.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One row per position. Cash is NOT stored here (see CashBalance).
model Holding {
  id               String   @id @default(cuid())
  ticker           String
  name             String
  assetClass       String // "Equities" | "Fixed Income" | "Alternatives" (validated in code)
  sector           String? // equities only
  subtype          String? // Fixed Income: maturity bucket; Alternatives: type (validated in code); empty for equities
  shares           Float
  costBasisPerShare Float
  currentPrice     Float // from the market data API; the manual value stays when no price is available
  noLivePrice      Boolean  @default(false) // true when the API had no price at the last refresh
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([assetClass, ticker])
}

// The portfolio's cash is a single amount, stored as one row (id is always 1).
model CashBalance {
  id        Int      @id @default(1)
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt
}

// One row (id always 1): tracks whether the demo portfolio is loaded and
// whether first-run seeding has already happened.
model AppState {
  id         Int     @id @default(1)
  isDemoData Boolean @default(false)
  seeded     Boolean @default(false)
  pricesUpdatedAt DateTime? // last time prices were refreshed from the market data API
  fundsSeeded Boolean @default(false) // the starting fund library has been inserted (only ever once)
}

// Known funds and their maturity (bonds) or type (alternatives), so Claude is only asked about funds not listed here.
// Starts with a built-in list; funds Claude looks up are saved here too.
model FundInfo {
  ticker        String   @id
  name          String
  assetClass    String // "Fixed Income" | "Alternatives"
  subtype       String // maturity bucket or alternatives type (validated in code)
  durationYears Float? // bond funds only; saved but not shown anywhere yet
  source        String // "builtin" | "claude"
  createdAt     DateTime @default(now())
}
