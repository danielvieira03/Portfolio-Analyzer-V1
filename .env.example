# Copy to .env.local (git-ignored) and fill in the keys you want to use. Both are optional.

# Needed only for Screenshot / PDF import and "Double-check with Claude".
# Get a key at https://console.anthropic.com. Never commit the real key.
ANTHROPIC_API_KEY=

# Needed for automatic prices and the ticker autofill in the Add/Edit form.
# Get a key at https://site.financialmodelingprep.com (the Starter plan allows 300 calls a minute; the free plan only about 250 a day, so raise PRICE_REFRESH_MINUTES in src/config/market.ts if you use it). Never commit the real key.
FINANCIAL_MODELING_API_KEY=
